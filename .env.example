# ==========================================================================
# Core
# ==========================================================================

LOG_LEVEL=info

# Redis powers the BullMQ queue provider and the Redis storage provider
# (per-user sessions). If unset, AgentConnect.fromEnv() falls back to
# in-memory providers — fine for local/dev, NOT for production or multiple
# processes/instances.
REDIS_URL=redis://127.0.0.1:6379

# Path to the project registry mapping project name -> absolute repo path
PROJECTS_CONFIG_PATH=./projects.json

# Which registered agent handles a user's prompts until they run `agent <name>`
DEFAULT_AGENT=claude

# Max number of agent executions processed concurrently across all users
# (a given user's own executions always run one at a time regardless of this)
AGENT_WORKER_CONCURRENCY=4

# Optional queue dashboard (Bull Board), served on ADMIN_PORT at /admin/queues,
# bound to 127.0.0.1 only. Only available when the queue provider is BullMQ.
ADMIN_ENABLED=true
ADMIN_PORT=3000

# ==========================================================================
# Security — leave blank to allow everyone (fine for a private single-user bot)
# ==========================================================================

# Comma-separated allowlist. Entries may be a bare platform user id (e.g. U123)
# or a platform-qualified id (e.g. slack:U123) if you run more than one
# messaging platform and need to disambiguate.
ALLOWED_USERS=
ALLOWED_CHANNELS=
ALLOWED_GROUPS=

# ==========================================================================
# Messaging: Slack — set these to enable the Slack adapter
# ==========================================================================

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_EDIT_THROTTLE_MS=1500
SLACK_PROGRESS_MAX_LINES=12

# ==========================================================================
# Messaging: Telegram — set this to enable the Telegram adapter
# ==========================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_EDIT_THROTTLE_MS=1500
TELEGRAM_PROGRESS_MAX_LINES=12

# ==========================================================================
# Agents
# ==========================================================================

# Claude Code CLI — enabled by default
CLAUDE_ENABLED=true
CLAUDE_CLI_PATH=claude
CLAUDE_TIMEOUT_MS=600000

# Cursor CLI (cursor-agent) — opt-in, requires a Cursor account/API key
CURSOR_ENABLED=false
CURSOR_CLI_PATH=cursor-agent
CURSOR_API_KEY=
CURSOR_TIMEOUT_MS=600000

# OpenAI Codex CLI — opt-in
CODEX_ENABLED=false
CODEX_CLI_PATH=codex
CODEX_TIMEOUT_MS=600000

# 🔐 Never commit this file with real values — .env is already gitignored.
 